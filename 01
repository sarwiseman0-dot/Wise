<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101014">
  <title>KUKA MUSIC</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #101014;
      color: white;
      font-family: Arial, sans-serif;
      padding: 24px;
      padding-bottom: 110px;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo { color: #a970ff; font-size: 27px; font-weight: bold; }
    .avatar {
      background: #a970ff;
      border-radius: 50%;
      padding: 12px;
    }
    h2 { margin-top: 35px; }
    .search {
      width: 100%;
      padding: 15px;
      border: 0;
      border-radius: 12px;
      background: #292932;
      color: white;
      font-size: 16px;
    }
    .songs {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
    .song {
      background: #202027;
      padding: 12px;
      border-radius: 15px;
    }
    .cover {
      height: 125px;
      background: linear-gradient(135deg,#7839bb,#191925);
      border-radius: 10px;
      display: grid;
      place-items: center;
      font-size: 42px;
    }
    .song p { margin-bottom: 4px; font-weight: bold; }
    .song small { color: #aaa; }
    nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #202027;
      display: flex;
      justify-content: space-around;
      padding: 18px 5px;
    }
    nav a { color: white; text-decoration: none; }
  </style>
</head>
<body>
  <header>
    <div class="logo">♫ KUKA MUSIC</div>
    <div class="avatar">K</div>
  </header>

  <h2>Bienvenue sur KUKA 🎵</h2>
  <input class="search" placeholder="Rechercher une musique...">

  <h2>Découvrir</h2>
  <div class="songs">
    <div class="song">
      <div class="cover">🎧</div>
      <p>Musique du moment</p>
      <small>Découverte</small>
    </div>
    <div class="song">
      <div class="cover">🎼</div>
      <p>Les nouveautés</p>
      <small>À écouter</small>
    </div>
    <div class="song">
      <div class="cover">🎤</div>
      <p>Hip-hop</p>
      <small>Playlist</small>
    </div>
    <div class="song">
      <div class="cover">🎹</div>
      <p>Afrobeat</p>
      <small>Playlist</small>
    </div>
  </div>

  <nav>
    <a href="#">🏠 Accueil</a>
    <a href="#">🔎 Recherche</a>
    <a href="#">📚 Bibliothèque</a>
  </nav>
</body>
</html>
